<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ABOT" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/abot_paper</item>
        <item name="android:navigationBarColor">@color/abot_paper</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>

    <style name="Theme.ABOT.QrScanner" parent="Theme.ABOT">
        <item name="android:windowBackground">@color/abot_paper</item>
        <item name="android:statusBarColor">@color/abot_paper</item>
        <item name="android:navigationBarColor">@color/abot_paper</item>
    </style>
</resources>

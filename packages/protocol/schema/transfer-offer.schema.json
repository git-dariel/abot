{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airbridge.local/schema/v1/transfer-offer.schema.json",
  "title": "Transfer offer payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["senderDeviceId", "files", "totalBytes"],
  "properties": {
    "senderDeviceId": { "type": "string", "format": "uuid" },
    "totalBytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "size", "sha256"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mediaType": { "type": "string", "maxLength": 127 }
        }
      }
    }
  }
}

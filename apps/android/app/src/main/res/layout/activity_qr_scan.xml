<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/abot_paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/qr_scan_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/qr_scan_top_control"
            android:contentDescription="Close QR scanner"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:tint="#050505" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Scan QR"
            android:textColor="#050505"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="42dp"
            android:layout_height="42dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/qr_scan_preview"
        android:clipToOutline="true">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/zxing_barcode_scanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="208dp"
            android:layout_height="208dp"
            android:layout_gravity="center"
            android:background="@drawable/qr_scan_frame"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="42dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan your PC code"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Center the ABOT QR code inside the frame."
                android:textColor="#E8F4FF"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
